{
    "schema-id": "dev.sinty.leafs",
    "settings": [
        {
            "key": "font-size",
            "label": "Font Size",
            "type": "int",
            "widget": "spin",
            "min": 6,
            "max": 72
        },
        {
            "key": "font-family",
            "label": "Font Family",
            "type": "string",
            "widget": "entry"
        },
        {
            "key": "scrollback-lines",
            "label": "Scrollback Lines",
            "type": "int",
            "widget": "spin",
            "min": 100,
            "max": 100000
        },
        {
            "key": "color-scheme",
            "label": "Color Scheme",
            "type": "string",
            "widget": "color-scheme-selector",
            "theme-set": "terminal"
        }
    ]
}
